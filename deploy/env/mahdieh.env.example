# ══════════════════════════════════════════════════════════════════════════════
# محیط تولید مهدیه — الگو. نسخهٔ واقعی را در /etc/mahdieh/mahdieh.env بگذارید
# با دسترسی ۶۴۰ و مالک mahdieh:mahdieh. **هرگز** این فایل را در مخزن نه گذارید.
# ══════════════════════════════════════════════════════════════════════════════
DJANGO_SETTINGS_MODULE=config.settings.production
# نام «محیط» همان چیزی است که تنظیمات می‌خواند: MAHDIEH_ENVIRONMENT
# (بدون پیشوند MAHDIEH_، هشدارهای مخصوص تولید هرگز روشن نمی‌شوند)
MAHDIEH_ENVIRONMENT=production
MAHDIEH_SITE_URL=https://mahdie-shohada.ir

# ── رازها (الزامی — نبودشان سامانه را بالا نمی‌آورد) ──────────────────────────
# تولید با: python -c "import secrets;print(secrets.token_urlsafe(64))"
MAHDIEH_SECRET_KEY=
# کلید رمزنگاری کد ملی (AES-GCM) — ۳۲ بایت base64. تغییرش دادهٔ قبلی را ناخوانا می‌کند!
FIELD_ENCRYPTION_KEY=
# کلید HMAC برای جست‌وجوی کور (blind index) کد ملی
FIELD_HASH_KEY=
MAHDIEH_ALLOWED_HOSTS=mahdie-shohada.ir,www.mahdie-shohada.ir
MAHDIEH_ADMINS=ops@mahdie-shohada.ir
# اطلاعات تماس پذیرش (اختیاری؛ خالی ⇒ خروجی فهرست تماس null می‌شود و
# بخش تماس صفحهٔ راهنما پنهان می‌ماند — هیچ شمارهٔ ساختگی چاپ نمی‌شود)
MAHDIEH_SUPPORT_PHONE=
MAHDIEH_SUPPORT_ADDRESS=مشهد، نوغان، کوچه ۱۱ شهید قائمی، درب سوم

# ── پایگاه‌داده ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mahdieh:__PASSWORD__@127.0.0.1:5432/mahdieh
# گذرواژه را همین‌جا (داخل URL) بگذارید کافی است؛ DATABASE_PASSWORD برای
# آن است که بخواهید راز را جدا از URL نگه دارید. اگر هیچ‌کدام نباشد، فرآیند
# بالا نمی‌آید (fail-fast). اگر هر دو باشند، DATABASE_PASSWORD اولویت دارد.
DATABASE_PASSWORD=__PASSWORD__
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ── کش و صف (Valkey/Redis) ───────────────────────────────────────────────────
VALKEY_URL=redis://127.0.0.1:6379/0

# ── ظرفیت (فرمول در docs/runbooks/deploy.md) ─────────────────────────────────
WEB_CONCURRENCY=3
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=5
LOAD_SHEDDING_ENABLED=true
LOAD_SHEDDING_MAX_CONCURRENCY=120
# سد WSGI: با کارگر sync خاموش بمانید — سدِ واقعی Nginx است (ADR-0016).
LOAD_SHEDDING_WSGI_ENABLED=false

# ── پیامک (اعتبارنامه‌ها بعداً توسط کارفرما) ──────────────────────────────────
# تا رسیدن اعتبارنامه‌ها: SMS_ENABLED=false و SMS_PROVIDER=mock ⇒ هیچ پیامک
# واقعی ارسال نمی‌شود و همهٔ تحویل‌ها «suppressed» ثبت می‌گردند.
SMS_ENABLED=false
# آداپتور: iranpayamak (الگومحور) · kavenegar · ghasedak · mock/console (آزمون)
SMS_PROVIDER=mock
SMS_API_KEY=
# برای ایران‌پیامک: شمارهٔ خط اختصاصی پنل (line_number) — خط مشترک زائرسرا
SMS_SENDER_NUMBER=
SMS_DAILY_BUDGET=2000
# کد الگوهای ثبت‌شده در پنل (JSON). قالب بی‌الگو ⇒ ارسال «مسدود» می‌شود.
# وضعیت و متن درخواست الگوهای باقی‌مانده: python manage.py sms_patterns --request
SMS_PATTERN_CODES=
SMS_ATTRIBUTE_DIGITS=persian

# ── پایش ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# ── فرانت جدا (CORS) ─────────────────────────────────────────────────────────
# مبدأ دقیق فرانت تیم فرانت؛ خالی ⇒ بسته. مثال:
#   MAHDIEH_CORS_ORIGINS=https://app.mahdie-shohada.ir
MAHDIEH_CORS_ORIGINS=
MAHDIEH_CROSS_SITE_COOKIES=false

# ── سیاست‌های امنیتی و عملیاتی (پیش‌فرض‌های عمدی — فقط اگر لازم شد تغییر دهید) ──
# چرا نوشته شده‌اند؟ چون «نبودن در فایل» یعنی «کسی تصمیم نگرفته». این‌ها تصمیم‌های
# گرفته‌شده‌اند؛ اگر روزی عوضشان کردید، دلیلش را در CHANGELOG ثبت کنید.
MAHDIEH_DEBUG=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# مسیر دریافت گزارش نقض CSP (برای خاموش‌کردن، مقدار none بگذارید)
# هیچ‌جا گزارش نمی‌رود اگر مقدار none باشد.
CSP_REPORT_URI=/csp-report/
CSP_REPORT_ONLY=false
HEALTH_DETAILED_PUBLIC=false
# (SameSite نشست خودکار از MAHDIEH_CROSS_SITE_COOKIES می‌آید: false ⇒ Lax، true ⇒ None)
STORAGE_BACKEND=local
OTP_MAX_ATTEMPTS=5
OTP_WINDOW_SECONDS=600
EXPORT_MAX_ROWS=200000
