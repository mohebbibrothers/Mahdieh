[Unit]
Description=Mahdieh DR drill (بازیابی آزمایشی هفتگی در پایگاه‌دادهٔ قرنطینه)
After=postgresql.service mahdieh-backup.service

[Service]
Type=oneshot
User=mahdieh
Group=mahdieh
EnvironmentFile=/etc/mahdieh/mahdieh.env
Environment=MAHDIEH_BACKUP_DIR=/srv/mahdieh/var/backups
ExecStart=/srv/mahdieh/scripts/dr_drill.sh
Nice=15
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mahdieh/var /srv/mahdieh/docs/drills
SyslogIdentifier=mahdieh-drill
