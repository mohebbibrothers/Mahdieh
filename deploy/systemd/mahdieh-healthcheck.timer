[Unit]
Description=زمان‌بند پایش سلامت مهدیه (هر ۵ دقیقه)

[Timer]
# هر ۵ دقیقه، در دقیقهٔ ثابت (۱، ۶، ۱۱، …) تا اجراها روی هم نیفتند و نمودار
# پایش «دندانه‌دار» و خوانا بماند.
OnCalendar=*-*-* *:01/5:00
# اجرای ازدست‌رفته جبران نمی‌شود: پایش، وضعیتِ **اکنون** را می‌گوید؛ اجرای
# گذشتهٔ آن ارزشی ندارد (و بی‌جهت هشدار کهنه می‌فرستد).
Persistent=false
AccuracySec=10s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
