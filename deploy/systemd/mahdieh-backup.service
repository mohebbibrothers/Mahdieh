[Unit]
Description=Mahdieh database backup (پشتیبان تأییدشده + بیانیه)
After=postgresql.service

[Service]
Type=oneshot
User=mahdieh
Group=mahdieh
EnvironmentFile=/etc/mahdieh/mahdieh.env
Environment=MAHDIEH_BACKUP_DIR=/srv/mahdieh/var/backups
Environment=MAHDIEH_RETENTION_DAYS=14
ExecStart=/srv/mahdieh/scripts/db_backup.sh --label nightly
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mahdieh/var /srv/mahdieh/scripts
SyslogIdentifier=mahdieh-backup
