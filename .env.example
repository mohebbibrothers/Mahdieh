# ══════════════════════════════════════════════════════════════════════════════
# مهدیه — نمونهٔ متغیرهای محیطی
# ══════════════════════════════════════════════════════════════════════════════
# قاعدهٔ پروژه: هر متغیری که اینجا هست، باید در تنظیمات خوانده شود، و هر
# متغیری که تنظیمات می‌خواند باید اینجا باشد. یک تست خودکار این هم‌خوانی را
# اجرا می‌کند (tests/test_env_example_parity.py) تا مستندات کهنه نشوند.
# ══════════════════════════════════════════════════════════════════════════════

# ── عمومی ─────────────────────────────────────────────────────────────────────
MAHDIEH_ENVIRONMENT=development
MAHDIEH_DEBUG=true
MAHDIEH_SECRET_KEY=dev-only-insecure-key-change-me-in-production
MAHDIEH_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAHDIEH_TIME_ZONE=Asia/Tehran
MAHDIEH_LANGUAGE_CODE=fa
MAHDIEH_SITE_URL=http://127.0.0.1:8000
MAHDIEH_ADMINS=admin@example.com
# راه تماس پذیرش (میز راهنما، برگ چاپی، پاورقی)
# ── اطلاعات تماس پذیرش (اختیاری) ─────────────────────────────────────────────
# این‌ها «دادهٔ کسب‌وکار» نیستند و در پایگاه‌داده ذخیره نمی‌شوند: فرانت می‌تواند
# نسخهٔ خودش را داشته باشد. دو مصرف واقعی دارند:
#   ۱) صفحهٔ راهنما/تماس در همین مخزن (نمونهٔ SSR)
#   ۲) خروجی GET /api/v1/meta ⇒ کلید contact (اگر خالی باشد، null می‌آید)
# نشانی زیر همان نشانی رسمی زائرسرا است؛ تلفن پذیرش را تیم فرانت تعیین می‌کند.
MAHDIEH_SUPPORT_PHONE=
MAHDIEH_SUPPORT_ADDRESS=مشهد، نوغان، کوچه ۱۱ شهید قائمی، درب سوم

# ── دیتابیس ───────────────────────────────────────────────────────────────────
# تولید: PostgreSQL 18 · توسعه: ۱۷ یا ۱۸ (بدون تفاوت رفتاری برای قیدها)
DATABASE_URL=postgres://mahdieh:mahdieh@127.0.0.1:5432/mahdieh
DATABASE_PASSWORD=
DATABASE_CONN_MAX_AGE=60
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CONN_HEALTH_CHECKS=true

# ── کش و صف (Valkey — سازگار با پروتکل Redis) ─────────────────────────────────
VALKEY_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=mahdieh
CACHE_DEFAULT_TTL_SECONDS=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── امنیت ─────────────────────────────────────────────────────────────────────
# دامنه‌هایی که فرم‌های CSRF از آن‌ها پذیرفته می‌شود (در تولید الزامی).
# نکته: اگر فرانت روی دامنهٔ دیگری است، این را دستی پر نکنید — MAHDIEH_CORS_ORIGINS
# خودش این فهرست را تغذیه می‌کند (یک منبع حقیقت).
CSRF_TRUSTED_ORIGINS=

# ── فرانت جدا (CORS) ─────────────────────────────────────────────────────────
# مبدأهای دقیق فرانت، با کاما جدا می‌شوند. خالی ⇒ کاملاً بسته (پیش‌فرض امن).
# قالب درست: https://app.example.com  (بدون مسیر و بدون اسلش پایانی)
# همین فهرست، CSRF_TRUSTED_ORIGINS را هم پر می‌کند تا «دکمه‌ای که کار نمی‌کند» نسازیم.
MAHDIEH_CORS_ORIGINS=
# کوکی بین‌دامنه‌ای (SameSite=None). فقط اگر فرانت روی دامنهٔ دیگری است و HTTPS
# دارید روشن کنید؛ بدون Secure، مرورگر کوکی را بی‌صدا دور می‌ریزد.
MAHDIEH_CROSS_SITE_COOKIES=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CSP_REPORT_ONLY=true
# هیچ‌جا گزارش نمی‌رود اگر مقدار none باشد.
CSP_REPORT_URI=/csp-report/

# ── رمزنگاری دادهٔ حساس (کد ملی) ──────────────────────────────────────────────
# تولید: از KMS/Vault بیاورید. چرخش کلید با نسخه‌بندی پشتیبانی می‌شود.
FIELD_ENCRYPTION_KEY=dev-only-32-byte-base64-key-0000000000000=
FIELD_HASH_KEY=dev-only-hmac-key-for-deterministic-lookup-000000

# ── تأیید دومرحله‌ای کارکنان (ADR-0018) ───────────────────────────────────────
# در تولید قفلِ «روشن» است؛ در توسعه برای آزمودن صفحهٔ عامل دوم روشن بگذارید.
MAHDIEH_STAFF_MFA_REQUIRED=true
# پنجرهٔ «تأیید تازه» برای کارهای پرخطر (ثانیه)
MAHDIEH_STAFF_MFA_STEP_UP_SECONDS=600

# ── زائران خارجی (ADR-0019) ───────────────────────────────────────────────────
# پذیرش شمارهٔ همراه غیرایرانی؛ فقط پس از تأیید تحویل بین‌المللی پنل پیامک روشن شود.
MAHDIEH_INTERNATIONAL_PHONES=false

# ── کد یک‌بارمصرف ─────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_WINDOW_SECONDS=600
OTP_MAX_PER_WINDOW=3

# ── پیامک (پورت/آداپتور — مشخصات واقعی در فاز ۵) ──────────────────────────────
SMS_ENABLED=false
# آداپتورها: mock/console (محلی، بی‌شبکه) · kavenegar · ghasedak · iranpayamak
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NUMBER=
SMS_FALLBACK_PROVIDER=
SMS_DAILY_BUDGET=1000
# کد الگوها برای «ارسال الگومحور» (ایران‌پیامک) — JSON و اختیاری.
# تا بالا آمدن دامنهٔ سایت، پنل هیچ الگویی را تأیید نمی‌کند؛ پس این خط خالی
# می‌ماند و سامانه صادقانه «پیامک آماده نیست» گزارش می‌دهد. روزی که کدها رسید:
#   scripts/sms_golive.sh --codes "otp_login=…,booking_confirmed=…,offer_created=…" \
#       --to 0912… --restart --selftest
# نمونه: {"otp_login": "AbC123xyz", "booking_confirmed": "Zz9Yy8Xx7"}
# هر قالبی که الگو نداشته باشد، ارسالش «مسدود» ثبت می‌شود (نه پیام ناقص).
SMS_PATTERN_CODES=
# قالب ارقام داخل متغیرهای الگو: persian (پیش‌فرض) یا latin
SMS_ATTRIBUTE_DIGITS=persian

# ── رسانه و ذخیره‌سازی ────────────────────────────────────────────────────────
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=mahdieh-media
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=900

# ── ایمیل (قالب مدرن Django 6.1: دیکشنری MAILERS) ────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# ── مشاهده‌پذیری و لاگ ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=mahdieh-web
SENTRY_DSN=

# ── ظرفیت: استخر اتصال پایگاه‌داده و سدِ بار (فاز ۸) ─────────────────────────
# فرمول: WEB_CONCURRENCY × DATABASE_POOL_MAX_SIZE ≤ max_connections − ذخیرهٔ اپراتور
# جزئیات و جدول ظرفیت: docs/runbooks/deploy.md
DATABASE_POOL_ENABLED=true
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=8
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_MAX_LIFETIME=1800
DATABASE_CONN_MAX_AGE=600
DATABASE_STATEMENT_TIMEOUT_MS=5000
LOAD_SHEDDING_ENABLED=true
LOAD_SHEDDING_MAX_CONCURRENCY=120
# سد ظرفیت WSGI — پیش‌فرض خاموش. با کارگر sync (تولید ما) سدِ واقعی Nginx است؛
# اگر به کارگر رشته‌ای (gthread/uvicorn-worker) کوچیدید، true کنید. دلیل: ADR-0016
LOAD_SHEDDING_WSGI_ENABLED=false

# ── ایمیل عملیاتی (هشدار خطا و مکاتبات؛ کانال اصلی زائر پیامک است) ──────────
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@mahdie-shohada.ir
SERVER_EMAIL=no-reply@mahdie-shohada.ir
MAHDIEH_ADMINS=ops@mahdie-shohada.ir

# ── موتور اکسل و خروجی‌ها ─────────────────────────────────────────────────────
EXPORT_MAX_ROWS=200000
EXPORT_LINK_TTL_SECONDS=86400

# ── سلامت ─────────────────────────────────────────────────────────────────────
HEALTH_DETAILED_PUBLIC=false

# ── حالت نمایش (فقط توسعه) ────────────────────────────────────────────────────
# اگر true باشد، مسیر /demo/guest/ و /demo/staff/ در محیط توسعه فعال می‌شود تا
# سایت بدون پیامک واقعی قابل بازدید باشد. در تولید همیشه false بماند.
MAHDIEH_DEMO_MODE=false
