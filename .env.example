# ══════════════════════════════════════════════════════════════════════════════
# مهدیه — نمونهٔ متغیرهای محیطی
# ══════════════════════════════════════════════════════════════════════════════
# قاعدهٔ پروژه: هر متغیری که اینجا هست، باید در تنظیمات خوانده شود، و هر
# متغیری که تنظیمات می‌خواند باید اینجا باشد. یک تست خودکار این هم‌خوانی را
# اجرا می‌کند (tests/test_env_example_parity.py) تا مستندات کهنه نشوند.
# ══════════════════════════════════════════════════════════════════════════════

# ── عمومی ─────────────────────────────────────────────────────────────────────
MAHDIEH_ENVIRONMENT=development
MAHDIEH_DEBUG=true
MAHDIEH_SECRET_KEY=dev-only-insecure-key-change-me-in-production
MAHDIEH_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAHDIEH_TIME_ZONE=Asia/Tehran
MAHDIEH_LANGUAGE_CODE=fa
MAHDIEH_SITE_URL=http://127.0.0.1:8000
MAHDIEH_ADMINS=admin@example.com

# ── دیتابیس ───────────────────────────────────────────────────────────────────
# تولید: PostgreSQL 18 · توسعه: ۱۷ یا ۱۸ (بدون تفاوت رفتاری برای قیدها)
DATABASE_URL=postgres://mahdieh:mahdieh@127.0.0.1:5432/mahdieh
DATABASE_PASSWORD=            
DATABASE_CONN_MAX_AGE=60
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CONN_HEALTH_CHECKS=true

# ── کش و صف (Valkey — سازگار با پروتکل Redis) ─────────────────────────────────
VALKEY_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=mahdieh
CACHE_DEFAULT_TTL_SECONDS=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── امنیت ─────────────────────────────────────────────────────────────────────
# دامنه‌هایی که فرم‌های CSRF از آن‌ها پذیرفته می‌شود (در تولید الزامی)
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CSP_REPORT_ONLY=true
CSP_REPORT_URI=

# ── رمزنگاری دادهٔ حساس (کد ملی) ──────────────────────────────────────────────
# تولید: از KMS/Vault بیاورید. چرخش کلید با نسخه‌بندی پشتیبانی می‌شود.
FIELD_ENCRYPTION_KEY=dev-only-32-byte-base64-key-0000000000000=
FIELD_HASH_KEY=dev-only-hmac-key-for-deterministic-lookup-000000

# ── پیامک (پورت/آداپتور — مشخصات واقعی در فاز ۵) ──────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NUMBER=
SMS_FALLBACK_PROVIDER=
SMS_DAILY_BUDGET=1000

# ── رسانه و ذخیره‌سازی ────────────────────────────────────────────────────────
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=mahdieh-media
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=900

# ── ایمیل (قالب مدرن Django 6.1: دیکشنری MAILERS) ────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# ── مشاهده‌پذیری و لاگ ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_SERVICE_NAME=mahdieh-web
SENTRY_DSN=

# ── موتور اکسل و خروجی‌ها ─────────────────────────────────────────────────────
EXPORT_MAX_ROWS=200000
EXPORT_LINK_TTL_SECONDS=86400

# ── سلامت ─────────────────────────────────────────────────────────────────────
HEALTH_DETAILED_PUBLIC=false
